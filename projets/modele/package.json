{
  "name": "modele",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "doc": "jsdoc -c jsdoc-conf.json && node -e \"require('fs').cpSync('img', 'docs/img', { recursive: true })\"",
    "publish": "dotenv -e .env -- bash scripts/publish.sh",
    "all": "npm run lint && npm run test:run && npm run doc && npm run build && npm run check",
    "check": "node scripts/check-dist.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maintained/eslint-plugin-filename-rules": "^1.5.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
